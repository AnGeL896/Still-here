[gd_resource type="Resource" script_class="NoteData" format=3]

[ext_resource type="Script" path="res://scripts/story/note_data.gd" id="1_note"]

[resource]
script = ExtResource("1_note")
id = "courtyard_note_02"
title = "Приказ о отключении"
author = "Городская электростанция, участок 4"
pages = PackedStringArray("Настоящим предписывается: произвести полное отключение электроснабжения участка 4 в связи с ликвидацией производственных мощностей.", "Отключению подлежат: трансформаторная будка (ТМ-4), распределительный щит в жилом доме, уличное освещение.", "Исполнитель: техник участка. Срок: до 25 октября. Прим.: при неисправности оборудования — доложить в диспетчерскую.", "Приписка карандашом: «ТМ-4 не выключать. Акт на отключение затерялся. Я его не подписывал.»")