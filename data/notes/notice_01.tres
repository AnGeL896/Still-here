[gd_resource type="Resource" script_class="NoteData" format=3]

[ext_resource type="Script" path="res://scripts/story/note_data.gd" id="1_emp7v"]

[resource]
script = ExtResource("1_emp7v")
id = "notice_01"
title = "Объявление"
author = "Городская служба, участок 4"
pages = PackedStringArray("Уважаемые жильцы! В связи с закрытием завода и отключением теплоснабжения просим освободить помещения до 25-го числа. Ключи сдать в домоуправление.", "Служебная строка: код подъездного сейфа — 4-7-1. После смены кода записку уничтожить.", "Приписка от руки: «В 4-й квартире свет не выключать. Я обещал.»")
