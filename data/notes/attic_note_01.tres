[gd_resource type="Resource" script_class="NoteData" format=3]

[ext_resource type="Script" path="res://scripts/story/note_data.gd" id="1_note"]

[resource]
script = ExtResource("1_note")
id = "attic_note_01"
title = "Дневник техника"
author = "— найдено среди хлама"
pages = PackedStringArray("12 октября. Произвёл осмотр участка. ТМ-4 работает, но гудит громче обычного. Подшипник, наверное. Надо будет заменить.", "13 октября. Д会 смазал подшипник. Гул не прекратился. Странно.", "14 октября. Гул усиливается. Ночью не могу спать — будто кто-то зовёт. Жена говорит, что ничего не слышит.", "15 октября. Пошёл в подвал проверить счётчик. На обратном пути услышал шаги наверху. В доме никого не должно быть.", "16 октября. Шаги повторяются каждую ночь в 3:15. Поднимался на чердак — пусто. Но пыль на стропилах потревожена.", "17 октября. Нашёл на чердаке старый журнал. Предыдущий техник писал то же самое. Дата последней записи — 10 лет назад.", "18 октября. Решил не выключать свет. Если кто-то ходит — пусть видит, что дом не пуст. Может, тогда не тронет.")