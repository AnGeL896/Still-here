[gd_resource type="Resource" script_class="NoteData" format=3]

[ext_resource type="Script" path="res://scripts/story/note_data.gd" id="1_note"]

[resource]
script = ExtResource("1_note")
id = "basement_note_02"
title = "Инструкция по технике безопасности"
author = "ОТКЗ, участок 4"
pages = PackedStringArray("1. Перед началом работ отключить вводной автомат.\n2. Проверить отсутствие напряжения индикатором.\n3. При работе в подвале — не приближаться к щиту ближе 1 метра.", "4. Запрещается: работать в одиночку при неисправном освещении.\n5. Запрещается: игнорировать запах гари.\n6. Запрещается: оставлять инструмент под напряжением.", "Приписка: «Пункт 4 нарушен. Пункт 5 нарушен. Пункт 6 нарушен. Кто это писал — тот и виноват.»")